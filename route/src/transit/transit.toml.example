# butterfly-route transit configuration — example file
#
# Drop a copy of this file at `<data_dir>/transit/transit.toml` and edit
# to match your needs, then run:
#
#     butterfly-route transit-fetch --data-dir <data_dir>
#
# to refresh the static feeds. Restart the server to pick up the new data.
# The server itself does NOT poll feeds in the background — refresh is a
# rebuild-time operation, exactly like the OSM PBF.

# ============================================================================
# Sizing knobs
# ============================================================================

# Maximum walking radius from origin / to destination (meters). Used as a
# default by the /transit handler when access_mode = "foot". Per-request
# `max_walk_m` query param overrides this.
max_walk_m = 2000

# Radius (meters) for the precomputed stop-to-stop walking transfer graph.
# Wider values pick up more cross-operator interchanges at the cost of a
# larger initial transfer build, but the ULTRA triangle dominance
# restriction prunes the graph back so the runtime cost is small.
# 2000 m is the recommended default for dense multi-operator regions.
transfer_radius_m = 2000

# Number of nearest transit stops to fan out to at the origin / destination.
max_access_stops = 20

# ============================================================================
# Feeds
# ============================================================================
#
# Each [[feeds]] entry describes one operator. `format` defaults to "gtfs".
# Today the loader supports:
#
#   format = "gtfs"        — GTFS static (.zip)
#   format = "netex-epip"  — NeTEx-EPIP profile (.xml)
#
# A `rt_url` is an optional one-shot GTFS-RT trip-updates snapshot. It is
# downloaded by `transit-fetch --realtime` and applied once at server
# startup. There is no realtime polling loop.
#
# THIS FILE IS AN OVERRIDE, AND WRITING ONE MAKES YOU ITS MAINTAINER.
# Without it, the feed list comes from the region index shipped with the
# binary (`dl/regions/<region>.toml`) — the same list `butterfly-dl
# <region>` fetches, so a URL that moves is corrected in one place. This
# file used to carry its own copy of the Belgian URLs; two of them rotted
# and nothing noticed, which is the whole reason the list now has a single
# home. Copy the entries you actually want to change, not all of them.
#
# `transit-fetch` fails the run if any listed feed does not download, and
# names the feed, the URL and this file.

# ----- one operator, overriding the shipped entry ---------------------------
[[feeds]]
id     = "sncb"
url    = "https://example.org/sncb-gtfs.zip"
format = "gtfs"

# ----- a NeTEx-EPIP publication ---------------------------------------------
# [[feeds]]
# id     = "stib"
# url    = "https://example.org/stib-epip.xml"
# format = "netex-epip"

# ============================================================================
# Knowingly excluded operators
# ============================================================================
#
# A feed that does not download fails the whole run, and that is on purpose:
# a rotted URL used to be printed and then ignored, so a rebuild quietly
# produced a timetable one operator short for months.
#
# Sometimes there is genuinely nothing to fix on our side — the published
# address is the broken one, and the alternative is a different format, which
# is real work rather than a URL change. Shipping without that operator is
# then a legitimate decision, but it has to be a DECISION, written down here:
#
#   [[excluded_feeds]]
#   id     = "some-operator"
#   reason = "published address 404s at the source; tracked upstream, no
#             replacement in this format yet"
#
# What a declaration does:
#
#   * the operator is not downloaded, and the run succeeds without it;
#   * it is not merged into the timetable either — one meaning, not two;
#   * every `transit-fetch` run prints it, and the server's /health names it
#     under `transit_feeds.excluded` with the reason;
#   * every feed that is NOT declared still fails the run.
#
# `reason` is required, and the id must match a configured feed: a stale
# declaration left behind after the feed is renamed or fixed is an error, not
# a no-op. You cannot exclude every feed — that would fetch nothing and
# succeed, which is the silence this whole mechanism exists to prevent.
