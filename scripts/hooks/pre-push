#!/bin/bash
# LOCAL CI — runs THE step list (scripts/ci-steps.sh), the same one
# .github/workflows/ci.yml runs (issues #485/#555), so a break is caught
# BEFORE it reaches main without relying on the remote runner or a rule
# bypass. Install: scripts/hooks/install.sh (symlinks .git/hooks/pre-push
# here, so editing this file updates the installed hook). Skip a single push
# with BUTTERFLY_NO_VERIFY=1 (emergencies only — the remote build-test check
# still gates the PR).
set -uo pipefail
[ "${BUTTERFLY_NO_VERIFY:-0}" = "1" ] && { echo "[pre-push] SKIPPED (BUTTERFLY_NO_VERIFY=1)"; exit 0; }
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
echo "[pre-push] local CI — $(bash scripts/ci-steps.sh --list | tr '\n' ',' | sed 's/,$//')"
if ! CI_STEP_PREFIX="[pre-push]" bash scripts/ci-steps.sh; then
  echo "[pre-push] push aborted. Fix, or BUTTERFLY_NO_VERIFY=1 git push to force."
  exit 1
fi
